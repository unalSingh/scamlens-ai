# ScamLens AI 3D (Apple Vision Pro Edition) Configuration
# ============================================================

# Primary: Google Gemini API (Recommended)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey (starts with AIzaSy...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google reCAPTCHA v3 / Enterprise Secret Key
RECAPTCHA_SECRET_KEY=

# Secondary / Optional: OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Provider Selection: 'gemini', 'openai', or 'auto'
LLM_PROVIDER=auto

# Master LLM switch (if false, strictly uses offline heuristic rule & visual engine)
USE_LLM=true

# Optional SQLite database path override
# SCAMLENS_DB_PATH=scamlens_history.db
